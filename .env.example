# Example environment for: uv run --env-file=.env molu …
# molu does not load this file itself — only the process environment.
#
# BioPortal — https://bioportal.bioontology.org/account
# (BIOONTOLOGY_API_KEY is also accepted as an alias)
# Leave unset / commented — an empty assignment shadows the alias.
# BIOPORTAL_API_KEY=

# UMLS / UTS — https://uts.nlm.nih.gov/uts/profile (license required)
# UMLS_API_KEY=

# Optional overrides
# BIOPORTAL_BASE_URL=https://data.bioontology.org
# UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
# UMLS_VERSION=current
